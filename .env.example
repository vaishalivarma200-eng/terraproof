# ==========================================
# TERRAPROOF ENVIRONMENT CONFIGURATION
# ==========================================
# Copy this file to .env and configure values for your local environment:
#   Copy-Item .env.example .env

# --- Application Mode ---
# Choices: "demo" (uses offline fixtures & synthetic rasters) or "real" (queries live STAC & weather APIs)
TERRAPROOF_MODE=demo

# --- Server Settings ---
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# For quick local student setup without Docker/PostgreSQL, SQLite is used by default.
# For production PostgreSQL / PostGIS:
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/terraproof
DATABASE_URL=sqlite:///./terraproof.db

# --- Satellite & Environmental Data Providers ---
# 1. Planetary Computer STAC (Open & Free metadata access)
# No API key required for public collections; SAS tokens auto-generated when querying assets.
STAC_API_URL=https://planetarycomputer.microsoft.com/api/stac/v1

# 2. Copernicus Data Space Ecosystem (CDSE) [Optional: for direct raw Sentinel downloads]
# Register free at: https://dataspace.copernicus.eu/
CDSE_CLIENT_ID=your_cdse_client_id_here
CDSE_CLIENT_SECRET=your_cdse_client_secret_here

# 3. Open-Meteo Weather API (Free, high-resolution historical precipitation & soil moisture)
# No API key needed for non-commercial student & research usage.
OPEN_METEO_API_URL=https://archive-api.open-meteo.com/v1/archive

# --- Storage & Artifacts ---
DATA_OUTPUT_DIR=./data/outputs
FIXTURES_DIR=./data/fixtures
MAX_UPLOAD_SIZE_MB=25
